@baseUrl = http://localhost:3001/api

### Listar productos
GET {{baseUrl}}/productos

### Filtrar por categoría
GET {{baseUrl}}/productos?categoria=solar

### Consultar producto
GET {{baseUrl}}/productos/1

### Crear producto
POST {{baseUrl}}/productos
Content-Type: application/json

{
  "nombre": "Ventilador eficiente",
  "categoria": "electrodomesticos",
  "precio": 180000,
  "wattsAntes": 100,
  "wattsDespues": 45,
  "horasDia": 6
}

### Actualizar producto
PUT {{baseUrl}}/productos/1
Content-Type: application/json

{
  "nombre": "Bombillo LED 9 W actualizado",
  "categoria": "iluminacion",
  "precio": 9000,
  "wattsAntes": 60,
  "wattsDespues": 9,
  "horasDia": 5
}

### Eliminar producto
DELETE {{baseUrl}}/productos/9

### Crear pedido
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "cliente": "Cliente de prueba",
  "productos": [
    { "productoId": 1, "cantidad": 2 },
    { "productoId": 2, "cantidad": 1 }
  ]
}

### Listar pedidos
GET {{baseUrl}}/pedidos

### Error esperado: datos inválidos (400)
POST {{baseUrl}}/productos
Content-Type: application/json

{
  "nombre": "",
  "categoria": "inexistente",
  "precio": -1
}

### Error esperado: no encontrado (404)
GET {{baseUrl}}/productos/999999
